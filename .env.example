# Copy to .env and fill in. Never commit .env.
# Crusoe keys can contain "$" — in a shell, export with SINGLE quotes:
#   export CRUSOE_API_KEY='your-key'
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# Nemotron models. IDs are case-sensitive — confirm with:
#   python financial-agent/scripts/check_crusoe.py
# Planner/checker: the bigger model, for planning and judging work.
PLANNER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# Workers: cheap, fast, built for long-running sub-agents.
WORKER_MODEL=nvidia/Nemotron-3.5-Lightning-30B-A3B
