# Copy to .env and fill in. Never commit .env.
# Crusoe keys can contain "$" — in a shell, export with SINGLE quotes:
#   export CRUSOE_API_KEY='your-key'
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# ---- Agent stack (workstream 1): Nemotron models. IDs are case-sensitive — confirm with:
#   python scripts/check_crusoe.py
# Planner/checker: the bigger model, for planning and judging work.
PLANNER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# Workers: cheap, fast, built for long-running sub-agents.
WORKER_MODEL=nvidia/Nemotron-3.5-Lightning-30B-A3B

# ---- Drift supervisor + GEPA (workstream 3)
# Supervisor inference model (cheap, high volume)
SUPERVISOR_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# GEPA reflection model (stronger reasoner), configured separately
REFLECTION_MODEL=deepseek-ai/DeepSeek-V4-Pro
SUPERVISOR_MAX_CONCURRENCY=4
# "true"/"false" to pin model reasoning via chat_template_kwargs (thinking / enable_thinking per model); leave unset to omit
SUPERVISOR_THINKING=false
# Only set true after scripts/smoke_test.py confirms response_format is supported
SUPERVISOR_JSON_MODE=false
