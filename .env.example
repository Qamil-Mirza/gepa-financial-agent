# Copy to .env and fill in. Never commit .env.
# Crusoe keys can contain "$": in a shell, export with SINGLE quotes.

# ---- Inference (Crusoe)
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# ---- Runtime
# State directory (runs, research cache); default ~/.pitstop
PITSTOP_HOME=
PITSTOP_RUNS_DIR=
PITSTOP_CACHE_DIR=
PITSTOP_SUPERVISOR_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
PITSTOP_WORKER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
PITSTOP_REPORT_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
PITSTOP_MAX_RESEARCH_CALLS=12

# ---- Research (You.com)
YDC_API_KEY=
PITSTOP_YOUCOM_EFFORT=deep

# ---- Calibration / benchmarks
SUPERVISOR_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
REFLECTION_MODEL=deepseek-ai/DeepSeek-V4-Pro
SUPERVISOR_MAX_CONCURRENCY=4
# "true"/"false" to pin model reasoning; leave empty to omit
SUPERVISOR_THINKING=
SUPERVISOR_JSON_MODE=false
JUDGE_MODEL=
WORKER_MODEL=nvidia/Nemotron-3.5-Lightning-30B-A3B
